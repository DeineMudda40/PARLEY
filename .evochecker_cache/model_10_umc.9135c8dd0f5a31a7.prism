formula due_gps = (step_gps>=c_gps);
module Knowledge
  xhat : [0..N] init xstart;
  yhat : [0..N] init ystart;
  step_gps : [1..10] init 1;
  [west] true -> (xhat'=max(xhat-1, 0));

  [east] true -> (xhat'=min(xhat+1, N));

  [south] true -> (yhat'=max(yhat-1, 0));

  [north] true -> (yhat'=min(yhat+1, N));


  [update_gps] due_gps -> (xhat'=x) & (yhat'=y) & (step_gps'=1);

  [skip_update] !(due_gps) ->(step_gps'=min(step_gps+1,10));
endmodule


rewards "cost" 
  [west] true : 1; 
  [east] true : 1; 
  [south] true : 1; 
  [north] true : 1; 
  [update_gps] true : 5;
endrewards 


module URC
  c_gps : [1..10] init 10;

  // URC transitions: sample c_<service> from its distribution per observation
  [URC] xhat=0 & yhat=0 -> gps_decision_x_0_y_0ph1 : (c_gps'=1) + gps_decision_x_0_y_0ph2 : (c_gps'=2) + gps_decision_x_0_y_0ph3 : (c_gps'=3) + gps_decision_x_0_y_0ph4 : (c_gps'=4) + gps_decision_x_0_y_0ph5 : (c_gps'=5) + gps_decision_x_0_y_0ph6 : (c_gps'=6) + gps_decision_x_0_y_0ph7 : (c_gps'=7) + gps_decision_x_0_y_0ph8 : (c_gps'=8) + gps_decision_x_0_y_0ph9 : (c_gps'=9) + gps_decision_x_0_y_0ph10 : (c_gps'=10);
  [URC] xhat=0 & yhat=1 -> gps_decision_x_0_y_1ph1 : (c_gps'=1) + gps_decision_x_0_y_1ph2 : (c_gps'=2) + gps_decision_x_0_y_1ph3 : (c_gps'=3) + gps_decision_x_0_y_1ph4 : (c_gps'=4) + gps_decision_x_0_y_1ph5 : (c_gps'=5) + gps_decision_x_0_y_1ph6 : (c_gps'=6) + gps_decision_x_0_y_1ph7 : (c_gps'=7) + gps_decision_x_0_y_1ph8 : (c_gps'=8) + gps_decision_x_0_y_1ph9 : (c_gps'=9) + gps_decision_x_0_y_1ph10 : (c_gps'=10);
  [URC] xhat=0 & yhat=2 -> gps_decision_x_0_y_2ph1 : (c_gps'=1) + gps_decision_x_0_y_2ph2 : (c_gps'=2) + gps_decision_x_0_y_2ph3 : (c_gps'=3) + gps_decision_x_0_y_2ph4 : (c_gps'=4) + gps_decision_x_0_y_2ph5 : (c_gps'=5) + gps_decision_x_0_y_2ph6 : (c_gps'=6) + gps_decision_x_0_y_2ph7 : (c_gps'=7) + gps_decision_x_0_y_2ph8 : (c_gps'=8) + gps_decision_x_0_y_2ph9 : (c_gps'=9) + gps_decision_x_0_y_2ph10 : (c_gps'=10);
  [URC] xhat=0 & yhat=3 -> gps_decision_x_0_y_3ph1 : (c_gps'=1) + gps_decision_x_0_y_3ph2 : (c_gps'=2) + gps_decision_x_0_y_3ph3 : (c_gps'=3) + gps_decision_x_0_y_3ph4 : (c_gps'=4) + gps_decision_x_0_y_3ph5 : (c_gps'=5) + gps_decision_x_0_y_3ph6 : (c_gps'=6) + gps_decision_x_0_y_3ph7 : (c_gps'=7) + gps_decision_x_0_y_3ph8 : (c_gps'=8) + gps_decision_x_0_y_3ph9 : (c_gps'=9) + gps_decision_x_0_y_3ph10 : (c_gps'=10);
  [URC] xhat=0 & yhat=4 -> gps_decision_x_0_y_4ph1 : (c_gps'=1) + gps_decision_x_0_y_4ph2 : (c_gps'=2) + gps_decision_x_0_y_4ph3 : (c_gps'=3) + gps_decision_x_0_y_4ph4 : (c_gps'=4) + gps_decision_x_0_y_4ph5 : (c_gps'=5) + gps_decision_x_0_y_4ph6 : (c_gps'=6) + gps_decision_x_0_y_4ph7 : (c_gps'=7) + gps_decision_x_0_y_4ph8 : (c_gps'=8) + gps_decision_x_0_y_4ph9 : (c_gps'=9) + gps_decision_x_0_y_4ph10 : (c_gps'=10);
