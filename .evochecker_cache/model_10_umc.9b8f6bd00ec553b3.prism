    (e_gps/4.0): (xhat'=9) & (yhat'=5) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=7) -> 
    (1 - (e_gps/4.0)*3): (xhat'=9) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=6) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=8) -> 
    (1 - (e_gps/4.0)*3): (xhat'=9) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=7) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=9) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=8) & (step_gps'=1);

  [skip_update] !(due_gps) ->(step_gps'=min(step_gps+1,10));
endmodule


rewards "cost" 
  [west] true : 1; 
  [east] true : 1; 
  [south] true : 1; 
  [north] true : 1; 
  [update_gps] true : 5;
endrewards 


// ===== UA FSC (stochastic Mealy controller, ring transitions) =====
// - ua_s is the internal controller state, 1..S
// - Transitions form a fixed ring: 1->2->...->S->1
// - For each (service, ua_s, observation) we have an evolvable distribution
//   ua_thr_dist_<svc>_s<s>_<obs> over thresholds in [min_val..max_val].
// - For each service we also have an initial distribution ua_init_dist_<svc>.

// Initial threshold distributions per service

// Threshold distributions: one distribution per (service, ua_s, observation)

module UA
  ua_s : [1..3] init 1;
  c_gps : [1..10] init 10;

  // Initial sampling of thresholds c_<svc> from ua_init_dist_<svc>
  [UA_INIT_gps] (ua_s=1) & xhat=0 & yhat=0 -> ua_init_dist_gps1 : (c_gps'=1) + ua_init_dist_gps2 : (c_gps'=2) + ua_init_dist_gps3 : (c_gps'=3) + ua_init_dist_gps4 : (c_gps'=4) + ua_init_dist_gps5 : (c_gps'=5) + ua_init_dist_gps6 : (c_gps'=6) + ua_init_dist_gps7 : (c_gps'=7) + ua_init_dist_gps8 : (c_gps'=8) + ua_init_dist_gps9 : (c_gps'=9) + ua_init_dist_gps10 : (c_gps'=10);

  // Stochastic Mealy updates per (service, ua_s, observation)
  // Threshold is sampled from ua_thr_dist_<svc>_s<s>_<obs>, next ua_s is deterministic.
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=0 -> ua_thr_dist_gps_s1_x_0_y_0ph1 : (c_gps'=1) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph2 : (c_gps'=2) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph3 : (c_gps'=3) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph4 : (c_gps'=4) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph5 : (c_gps'=5) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph6 : (c_gps'=6) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph7 : (c_gps'=7) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph8 : (c_gps'=8) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph9 : (c_gps'=9) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_0ph10 : (c_gps'=10) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=1 -> ua_thr_dist_gps_s1_x_0_y_1ph1 : (c_gps'=1) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph2 : (c_gps'=2) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph3 : (c_gps'=3) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph4 : (c_gps'=4) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph5 : (c_gps'=5) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph6 : (c_gps'=6) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph7 : (c_gps'=7) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph8 : (c_gps'=8) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph9 : (c_gps'=9) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_1ph10 : (c_gps'=10) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=2 -> ua_thr_dist_gps_s1_x_0_y_2ph1 : (c_gps'=1) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph2 : (c_gps'=2) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph3 : (c_gps'=3) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph4 : (c_gps'=4) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph5 : (c_gps'=5) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph6 : (c_gps'=6) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph7 : (c_gps'=7) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph8 : (c_gps'=8) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph9 : (c_gps'=9) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_2ph10 : (c_gps'=10) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=3 -> ua_thr_dist_gps_s1_x_0_y_3ph1 : (c_gps'=1) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph2 : (c_gps'=2) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph3 : (c_gps'=3) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph4 : (c_gps'=4) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph5 : (c_gps'=5) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph6 : (c_gps'=6) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph7 : (c_gps'=7) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph8 : (c_gps'=8) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph9 : (c_gps'=9) & (ua_s'=2) + ua_thr_dist_gps_s1_x_0_y_3ph10 : (c_gps'=10) & (ua_s'=2);
