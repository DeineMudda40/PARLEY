    (e_gps/4.0): (xhat'=8) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=2) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=4) -> 
