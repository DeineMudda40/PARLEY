    (e_gps/4.0): (xhat'=9) & (yhat'=4) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=6) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=6) & (step_gps'=1) + 
