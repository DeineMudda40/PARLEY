module Turn
  t : [0..3] init 0;

  // Init phase: sample initial thresholds
  [UA_INIT_gps] (t=0) -> (t'=1);

  // Movement phase
  [east] (t=1) -> (t'=2);
  [west] (t=1) -> (t'=2);
  [north] (t=1) -> (t'=2);
  [south] (t=1) -> (t'=2);

  // Controller phase (FSC)
  [UA_STEP_gps] (t=2) -> (t'=3);

  // Update / skip phase
  [update_gps] (t=3) -> (t'=1);
  [skip_update] (t=3) -> (t'=1);

endmodule
