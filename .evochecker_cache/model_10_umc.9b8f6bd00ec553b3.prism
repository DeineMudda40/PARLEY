formula hasCrashed = (1=0) | (x=0 & y=6) | (x=0 & y=8) | (x=1 & y=2) | (x=1 & y=4) | (x=1 & y=5) | (x=1 & y=9) | (x=2 & y=4) | (x=2 & y=7) | (x=3 & y=3) | (x=3 & y=8) | (x=3 & y=9) | (x=4 & y=1) | (x=4 & y=4) | (x=4 & y=7) | (x=5 & y=1) | (x=5 & y=2) | (x=5 & y=5) | (x=5 & y=9) | (x=6 & y=2) | (x=6 & y=3) | (x=6 & y=4) | (x=6 & y=7) | (x=6 & y=8) | (x=6 & y=9) | (x=7 & y=4) | (x=8 & y=1) | (x=8 & y=5) | (x=8 & y=6) | (x=9 & y=3) ;

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  crashed : [0..1] init 0;

[west] true -> 
     p: (x'=min(x+1, N)) + 
    p: (y'=min(y+1, N)) + 
    p: (y'=max(y-1, 0)) + 
    (1-3*p): (x'=max(x-1, 0));

[east] true -> 
     (1-3*p): (x'=min(x+1, N)) + 
    p: (y'=min(y+1, N)) + 
    p: (y'=max(y-1, 0)) + 
    p: (x'=max(x-1, 0));

[south] true -> 
     p: (x'=min(x+1, N)) + 
    p: (y'=min(y+1, N)) + 
    (1-3*p): (y'=max(y-1, 0)) + 
    p: (x'=max(x-1, 0));

[north] true -> 
     p: (x'=min(x+1, N)) + 
    (1-3*p): (y'=min(y+1, N)) + 
    p: (y'=max(y-1, 0)) + 
    p: (x'=max(x-1, 0));


  [update_gps] hasCrashed  -> (crashed'=1);
  [update_gps] !hasCrashed -> (crashed'=crashed);
  [skip_update] hasCrashed  -> (crashed'=1);
  [skip_update] !hasCrashed -> (crashed'=crashed);
endmodule

