  // Initial sampling of thresholds c_<svc> (one-shot at the beginning)
  [UA_INIT_gps] (t=0) -> ua_init_dist_gps : (c_gps'=1) + ua_init_dist_gps : (c_gps'=2) + ua_init_dist_gps : (c_gps'=3) + ua_init_dist_gps : (c_gps'=4) + ua_init_dist_gps : (c_gps'=5) + ua_init_dist_gps : (c_gps'=6) + ua_init_dist_gps : (c_gps'=7) + ua_init_dist_gps : (c_gps'=8) + ua_init_dist_gps : (c_gps'=9) + ua_init_dist_gps : (c_gps'=10);

