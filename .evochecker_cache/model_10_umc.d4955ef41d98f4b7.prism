    (1 - (e_gps/4.0)*3): (xhat'=7) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=6) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=7) & (yhat'=4) & (step_gps'=1);
  [update_gps] due_gps & (x=7) & (y=4) -> 
    (1 - (e_gps/4.0)*2): (xhat'=7) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=7) & (yhat'=5) & (step_gps'=1) + 
