  [update_gps] due_gps & (x=9) & (y=9) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=8) & (step_gps'=1);

  [skip_update] !(due_gps) ->(step_gps'=min(step_gps+1,10));
endmodule


rewards "cost" 
  [west] true : 1; 
  [east] true : 1; 
  [south] true : 1; 
  [north] true : 1; 
  [update_gps] true : 5;
endrewards 


// ===== FSC with two independent evolve distributions (via synchronisation) =====
// We use:
//  * ua_tr_dist_s<state>_<obs>   for next-state selection
//  * ua_<svc>_act_dist_s<state>_<obs> for threshold selection
//  * ua_init_dist_<svc>          for initial threshold of each service

// Initial threshold distributions: per service -> c_<svc> in [min_val..max_val]

// State-transition distributions (S bins) per (ua_s, observation)

// Action/threshold distributions (10 bins) per (svc, ua_s, observation)

module UA_TR
  ua_s : [1..2] init 1;

  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=0 -> ua_tr_dist_s1_x_0_y_0 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_0 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=1 -> ua_tr_dist_s1_x_0_y_1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_1 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=2 -> ua_tr_dist_s1_x_0_y_2 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_2 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=3 -> ua_tr_dist_s1_x_0_y_3 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_3 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=4 -> ua_tr_dist_s1_x_0_y_4 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_4 : (ua_s'=2);
