    (e_gps/4.0): (xhat'=1) & (yhat'=0) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=2) -> 
    (1 - (e_gps/4.0)*3): (xhat'=1) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=1) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=3) -> 
    (1 - (e_gps/4.0)*4): (xhat'=1) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=2) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=4) -> 
    (1 - (e_gps/4.0)*3): (xhat'=1) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=3) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=5) -> 
    (1 - (e_gps/4.0)*4): (xhat'=1) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=6) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=4) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=6) -> 
    (1 - (e_gps/4.0)*2): (xhat'=1) & (yhat'=6) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=6) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=7) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=7) -> 
    (1 - (e_gps/4.0)*4): (xhat'=1) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=6) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=8) -> 
    (1 - (e_gps/4.0)*3): (xhat'=1) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=7) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=9) -> 
    (1 - (e_gps/4.0)*2): (xhat'=1) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=8) & (step_gps'=1);
  [update_gps] due_gps & (x=2) & (y=0) -> 
    (1 - (e_gps/4.0)*2): (xhat'=2) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=3) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=0) & (step_gps'=1);
  [update_gps] due_gps & (x=2) & (y=1) -> 
    (1 - (e_gps/4.0)*4): (xhat'=2) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=3) & (yhat'=1) & (step_gps'=1) + 
