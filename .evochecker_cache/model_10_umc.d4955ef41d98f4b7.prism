module Turn
  t : [0..3] init 0;

  // Initialisation phases: sample c_<svc> once from ua_init_dist_<svc>
  [UA_INIT_gps] (t=0) -> (t'=1);

  // Movement phase
  [east] (t=1) -> (t'=2);
  [west] (t=1) -> (t'=2);
  [north] (t=1) -> (t'=2);
  [south] (t=1) -> (t'=2);

  // Update / skip phase
  [update_gps] (t=2) -> (t'=3);
  [skip_update] (t=2) -> (t'=1);

  // FSC phase after each update_<svc>
  [UA_TR_gps] (t=3) -> (t'=1);
endmodule
