  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=6 -> ua_tr_dist_s1_x_0_y_6 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_6 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=7 -> ua_tr_dist_s1_x_0_y_7 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_7 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=8 -> ua_tr_dist_s1_x_0_y_8 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_8 : (ua_s'=2);
  [UA_TR_gps] (ua_s=1) & xhat=0 & yhat=9 -> ua_tr_dist_s1_x_0_y_9 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_9 : (ua_s'=2);
