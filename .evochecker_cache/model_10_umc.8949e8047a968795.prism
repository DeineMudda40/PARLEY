rewards "cost" 
  [west] true : 1; 
  [east] true : 1; 
  [south] true : 1; 
  [north] true : 1; 
  [update_gps] true : 5;
endrewards 


// ===== UA FSC (EvoChecker distributions) =====
// Distributions are used by repeating the distribution name once per branch,
// e.g., '-> dist : ... + dist : ... + dist : ...' (no indexing like dist(1)).

// Threshold emission distributions (10 bins) per (service, ua_s)

// State-transition distributions (S bins) per (ua_s, observation)

module UA
  ua_s : [1..2] init 1;
  c_gps : [1..10] init 10;

  // Threshold emission: sample c_<svc> based only on ua_s
  [UA_OUT_gps] (ua_s=1) -> ua_thr_dist_gps_s1ph1 : (c_gps'=1) + ua_thr_dist_gps_s1ph2 : (c_gps'=2) + ua_thr_dist_gps_s1ph3 : (c_gps'=3) + ua_thr_dist_gps_s1ph4 : (c_gps'=4) + ua_thr_dist_gps_s1ph5 : (c_gps'=5) + ua_thr_dist_gps_s1ph6 : (c_gps'=6) + ua_thr_dist_gps_s1ph7 : (c_gps'=7) + ua_thr_dist_gps_s1ph8 : (c_gps'=8) + ua_thr_dist_gps_s1ph9 : (c_gps'=9) + ua_thr_dist_gps_s1ph10 : (c_gps'=10);
  [UA_OUT_gps] (ua_s=2) -> ua_thr_dist_gps_s2ph1 : (c_gps'=1) + ua_thr_dist_gps_s2ph2 : (c_gps'=2) + ua_thr_dist_gps_s2ph3 : (c_gps'=3) + ua_thr_dist_gps_s2ph4 : (c_gps'=4) + ua_thr_dist_gps_s2ph5 : (c_gps'=5) + ua_thr_dist_gps_s2ph6 : (c_gps'=6) + ua_thr_dist_gps_s2ph7 : (c_gps'=7) + ua_thr_dist_gps_s2ph8 : (c_gps'=8) + ua_thr_dist_gps_s2ph9 : (c_gps'=9) + ua_thr_dist_gps_s2ph10 : (c_gps'=10);

  // FSC state transition: after update, update ua_s based on (ua_s, observed hat vars)
  [UA_TR] (ua_s=1) & xhat=0 & yhat=0 -> ua_tr_dist_s1_x_0_y_0ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_0ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=1 -> ua_tr_dist_s1_x_0_y_1ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_1ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=2 -> ua_tr_dist_s1_x_0_y_2ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_2ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=3 -> ua_tr_dist_s1_x_0_y_3ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_3ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=4 -> ua_tr_dist_s1_x_0_y_4ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_4ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=5 -> ua_tr_dist_s1_x_0_y_5ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_5ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=6 -> ua_tr_dist_s1_x_0_y_6ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_6ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=7 -> ua_tr_dist_s1_x_0_y_7ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_7ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=8 -> ua_tr_dist_s1_x_0_y_8ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_8ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=0 & yhat=9 -> ua_tr_dist_s1_x_0_y_9ph1 : (ua_s'=1) + ua_tr_dist_s1_x_0_y_9ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=1 & yhat=0 -> ua_tr_dist_s1_x_1_y_0ph1 : (ua_s'=1) + ua_tr_dist_s1_x_1_y_0ph2 : (ua_s'=2);
  [UA_TR] (ua_s=1) & xhat=1 & yhat=1 -> ua_tr_dist_s1_x_1_y_1ph1 : (ua_s'=1) + ua_tr_dist_s1_x_1_y_1ph2 : (ua_s'=2);
