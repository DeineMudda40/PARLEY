module Turn
  t : [0..3] init 0;
  [east] (t=0) -> (t'=1);
  [west] (t=0) -> (t'=1);
  [north] (t=0) -> (t'=1);
  [south] (t=0) -> (t'=1);

  // Update phase
  [update_gps] (t=1) -> (t'=2);
  [skip_update] (t=1) -> (t'=0);

  // UA threshold emission phases (only after an update)
  [UA_OUT_gps] (t=2) -> (t'=3);

  // UA transition phase (only after an update)
  [UA_TR] (t=3) -> (t'=0);
endmodule
