  [east] (xhat=8) & (yhat=9) -> true;
  [west] (xhat=9) & (yhat=0) -> true;
  [north] (xhat=9) & (yhat=2) -> true;
  [north] (xhat=9) & (yhat=3) -> true;
  [north] (xhat=9) & (yhat=4) -> true;
  [west] (xhat=9) & (yhat=5) -> true;
