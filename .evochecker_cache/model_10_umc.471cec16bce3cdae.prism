    (e_gps/4.0): (xhat'=7) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=0) & (step_gps'=1);
  [update_gps] due_gps & (x=8) & (y=2) -> 
    (1 - (e_gps/4.0)*2): (xhat'=8) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=2) & (step_gps'=1) + 
