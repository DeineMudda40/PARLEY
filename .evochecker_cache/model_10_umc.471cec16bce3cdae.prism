  [east] (xhat=5) & (yhat=7) -> true;
  [south] (xhat=5) & (yhat=8) -> true;
  [south] (xhat=5) & (yhat=9) -> true;
  [west] (xhat=6) & (yhat=0) -> true;
  [west] (xhat=6) & (yhat=1) -> true;
  [north] (xhat=6) & (yhat=2) -> true;
  [north] (xhat=6) & (yhat=3) -> true;
  [west] (xhat=6) & (yhat=4) -> true;
  [north] (xhat=6) & (yhat=6) -> true;
  [east] (xhat=6) & (yhat=7) -> true;
  [west] (xhat=6) & (yhat=9) -> true;
  [west] (xhat=7) & (yhat=0) -> true;
  [west] (xhat=7) & (yhat=1) -> true;
  [west] (xhat=7) & (yhat=3) -> true;
  [east] (xhat=7) & (yhat=7) -> true;
