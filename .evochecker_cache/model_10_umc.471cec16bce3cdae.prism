    (1 - (e_gps/4.0)*3): (xhat'=9) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=0) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=2) -> 
    (1 - (e_gps/4.0)*1): (xhat'=9) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=3) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=3) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=2) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=4) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=3) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=5) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=4) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=6) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=6) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=6) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=5) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=7) -> 
    (1 - (e_gps/4.0)*1): (xhat'=9) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=7) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=8) -> 
    (1 - (e_gps/4.0)*2): (xhat'=9) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=9) & (yhat'=9) & (step_gps'=1);
  [update_gps] due_gps & (x=9) & (y=9) -> 
    (1 - (e_gps/4.0)*1): (xhat'=9) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=8) & (yhat'=9) & (step_gps'=1);

  [skip_update] !(due_gps) ->(step_gps'=min(step_gps+1,10));
endmodule


rewards "cost" 
  [west] true : 1; 
  [east] true : 1; 
  [south] true : 1; 
  [north] true : 1; 
  [update_gps] true : 5;
endrewards 


// ===== UA FSC (deterministic Mealy controller, ring transitions) =====
// - ua_s is the internal controller state, 1..S
// - Transitions form a fixed ring: 1->2->...->S->1
// - For each (service, ua_s, observation) we have an evolvable int
//   ua_thr_<svc>_s<s>_<obs> deciding the next c_<svc> deterministically.

// Evolvable thresholds: one int per (service, ua_s, observation)


module UA
  ua_s : [1..5] init 1;
  c_gps : [1..10] init init_c_gps;

  // Deterministic Mealy updates per (service, ua_s, observation)
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=0 -> (c_gps'=ua_thr_gps_s1_x_0_y_0) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=1 -> (c_gps'=ua_thr_gps_s1_x_0_y_1) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=2 -> (c_gps'=ua_thr_gps_s1_x_0_y_2) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=3 -> (c_gps'=ua_thr_gps_s1_x_0_y_3) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=4 -> (c_gps'=ua_thr_gps_s1_x_0_y_4) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=5 -> (c_gps'=ua_thr_gps_s1_x_0_y_5) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=6 -> (c_gps'=ua_thr_gps_s1_x_0_y_6) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=7 -> (c_gps'=ua_thr_gps_s1_x_0_y_7) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=8 -> (c_gps'=ua_thr_gps_s1_x_0_y_8) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=0 & yhat=9 -> (c_gps'=ua_thr_gps_s1_x_0_y_9) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=0 -> (c_gps'=ua_thr_gps_s1_x_1_y_0) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=1 -> (c_gps'=ua_thr_gps_s1_x_1_y_1) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=2 -> (c_gps'=ua_thr_gps_s1_x_1_y_2) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=3 -> (c_gps'=ua_thr_gps_s1_x_1_y_3) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=4 -> (c_gps'=ua_thr_gps_s1_x_1_y_4) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=5 -> (c_gps'=ua_thr_gps_s1_x_1_y_5) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=6 -> (c_gps'=ua_thr_gps_s1_x_1_y_6) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=7 -> (c_gps'=ua_thr_gps_s1_x_1_y_7) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=8 -> (c_gps'=ua_thr_gps_s1_x_1_y_8) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=1 & yhat=9 -> (c_gps'=ua_thr_gps_s1_x_1_y_9) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=0 -> (c_gps'=ua_thr_gps_s1_x_2_y_0) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=1 -> (c_gps'=ua_thr_gps_s1_x_2_y_1) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=2 -> (c_gps'=ua_thr_gps_s1_x_2_y_2) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=3 -> (c_gps'=ua_thr_gps_s1_x_2_y_3) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=4 -> (c_gps'=ua_thr_gps_s1_x_2_y_4) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=5 -> (c_gps'=ua_thr_gps_s1_x_2_y_5) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=6 -> (c_gps'=ua_thr_gps_s1_x_2_y_6) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=7 -> (c_gps'=ua_thr_gps_s1_x_2_y_7) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=8 -> (c_gps'=ua_thr_gps_s1_x_2_y_8) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=2 & yhat=9 -> (c_gps'=ua_thr_gps_s1_x_2_y_9) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=0 -> (c_gps'=ua_thr_gps_s1_x_3_y_0) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=1 -> (c_gps'=ua_thr_gps_s1_x_3_y_1) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=2 -> (c_gps'=ua_thr_gps_s1_x_3_y_2) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=3 -> (c_gps'=ua_thr_gps_s1_x_3_y_3) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=4 -> (c_gps'=ua_thr_gps_s1_x_3_y_4) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=5 -> (c_gps'=ua_thr_gps_s1_x_3_y_5) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=6 -> (c_gps'=ua_thr_gps_s1_x_3_y_6) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=7 -> (c_gps'=ua_thr_gps_s1_x_3_y_7) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=8 -> (c_gps'=ua_thr_gps_s1_x_3_y_8) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=3 & yhat=9 -> (c_gps'=ua_thr_gps_s1_x_3_y_9) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=4 & yhat=0 -> (c_gps'=ua_thr_gps_s1_x_4_y_0) & (ua_s'=2);
  [UA_STEP_gps] (ua_s=1) & xhat=4 & yhat=1 -> (c_gps'=ua_thr_gps_s1_x_4_y_1) & (ua_s'=2);
