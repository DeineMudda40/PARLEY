formula due_gps = (step_gps>=c_gps);
module Knowledge
  xhat : [0..N] init xstart;
  yhat : [0..N] init ystart;
  step_gps : [1..10] init 1;
  [west] true -> (xhat'=max(xhat-1, 0));

  [east] true -> (xhat'=min(xhat+1, N));

  [south] true -> (yhat'=max(yhat-1, 0));

  [north] true -> (yhat'=min(yhat+1, N));


  [update_gps] due_gps & (x=0) & (y=0) -> 
    (1 - (e_gps/4.0)*2): (xhat'=0) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=1) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=1) -> 
    (1 - (e_gps/4.0)*3): (xhat'=0) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=0) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=2) -> 
    (1 - (e_gps/4.0)*2): (xhat'=0) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=1) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=3) -> 
    (1 - (e_gps/4.0)*2): (xhat'=0) & (yhat'=3) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=2) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=4) -> 
    (1 - (e_gps/4.0)*1): (xhat'=0) & (yhat'=4) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=4) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=5) -> 
    (1 - (e_gps/4.0)*3): (xhat'=0) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=5) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=6) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=4) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=6) -> 
    (1 - (e_gps/4.0)*0): (xhat'=0) & (yhat'=6) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=7) -> 
    (1 - (e_gps/4.0)*1): (xhat'=0) & (yhat'=7) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=6) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=8) -> 
    (1 - (e_gps/4.0)*1): (xhat'=0) & (yhat'=8) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=8) & (step_gps'=1);
  [update_gps] due_gps & (x=0) & (y=9) -> 
    (1 - (e_gps/4.0)*1): (xhat'=0) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=9) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=0) -> 
    (1 - (e_gps/4.0)*3): (xhat'=1) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=2) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=0) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=1) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=1) -> 
    (1 - (e_gps/4.0)*3): (xhat'=1) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=1) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=0) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=2) -> 
    (1 - (e_gps/4.0)*2): (xhat'=1) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=0) & (yhat'=2) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=1) & (yhat'=1) & (step_gps'=1);
  [update_gps] due_gps & (x=1) & (y=3) -> 
