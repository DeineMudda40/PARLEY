formula hasCrashed = (1=0) | (x=0 & y=3) | (x=0 & y=5) | (x=0 & y=7) | (x=0 & y=8) | (x=0 & y=9) | (x=1 & y=3) | (x=1 & y=6) | (x=1 & y=7) | (x=2 & y=1) | (x=2 & y=2) | (x=2 & y=3) | (x=2 & y=5) | (x=3 & y=1) | (x=3 & y=3) | (x=3 & y=5) | (x=3 & y=6) | (x=4 & y=5) | (x=4 & y=7) | (x=4 & y=9) | (x=5 & y=3) | (x=6 & y=5) | (x=6 & y=8) | (x=7 & y=2) | (x=7 & y=4) | (x=7 & y=5) | (x=7 & y=6) | (x=7 & y=8) | (x=7 & y=9) | (x=8 & y=2) | (x=8 & y=3) | (x=8 & y=4) | (x=9 & y=1) | (x=9 & y=6) | (x=9 & y=7) | (x=9 & y=8) ;

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  crashed : [0..1] init 0;

[west] true -> 
     p: (x'=min(x+1, N)) + 
    p: (y'=min(y+1, N)) + 
    p: (y'=max(y-1, 0)) + 
    (1-3*p): (x'=max(x-1, 0));

[east] true -> 
     (1-3*p): (x'=min(x+1, N)) + 
    p: (y'=min(y+1, N)) + 
    p: (y'=max(y-1, 0)) + 
    p: (x'=max(x-1, 0));

[south] true -> 
     p: (x'=min(x+1, N)) + 
    p: (y'=min(y+1, N)) + 
    (1-3*p): (y'=max(y-1, 0)) + 
    p: (x'=max(x-1, 0));

[north] true -> 
     p: (x'=min(x+1, N)) + 
    (1-3*p): (y'=min(y+1, N)) + 
    p: (y'=max(y-1, 0)) + 
    p: (x'=max(x-1, 0));


  [update_gps] hasCrashed  -> (crashed'=1);
  [update_gps] !hasCrashed -> (crashed'=crashed);
  [skip_update] hasCrashed  -> (crashed'=1);
  [skip_update] !hasCrashed -> (crashed'=crashed);
endmodule

module Adaptation_MAPE_controller
  [east] (xhat=0) & (yhat=0) -> true;
  [south] (xhat=0) & (yhat=1) -> true;
  [south] (xhat=0) & (yhat=2) -> true;
  [east] (xhat=0) & (yhat=4) -> true;
  [east] (xhat=1) & (yhat=0) -> true;
  [south] (xhat=1) & (yhat=1) -> true;
  [west] (xhat=1) & (yhat=2) -> true;
  [east] (xhat=1) & (yhat=4) -> true;
  [south] (xhat=1) & (yhat=5) -> true;
  [east] (xhat=1) & (yhat=8) -> true;
  [east] (xhat=1) & (yhat=9) -> true;
  [east] (xhat=2) & (yhat=0) -> true;
  [east] (xhat=2) & (yhat=4) -> true;
  [north] (xhat=2) & (yhat=6) -> true;
  [north] (xhat=2) & (yhat=7) -> true;
  [east] (xhat=2) & (yhat=8) -> true;
  [south] (xhat=2) & (yhat=9) -> true;
  [east] (xhat=3) & (yhat=0) -> true;
  [east] (xhat=3) & (yhat=2) -> true;
  [east] (xhat=3) & (yhat=4) -> true;
  [north] (xhat=3) & (yhat=7) -> true;
  [east] (xhat=3) & (yhat=8) -> true;
  [south] (xhat=3) & (yhat=9) -> true;
  [north] (xhat=4) & (yhat=0) -> true;
  [north] (xhat=4) & (yhat=1) -> true;
  [north] (xhat=4) & (yhat=2) -> true;
  [north] (xhat=4) & (yhat=3) -> true;
  [east] (xhat=4) & (yhat=4) -> true;
  [east] (xhat=4) & (yhat=6) -> true;
  [east] (xhat=4) & (yhat=8) -> true;
  [west] (xhat=5) & (yhat=0) -> true;
  [west] (xhat=5) & (yhat=1) -> true;
  [west] (xhat=5) & (yhat=2) -> true;
  [north] (xhat=5) & (yhat=4) -> true;
  [north] (xhat=5) & (yhat=5) -> true;
