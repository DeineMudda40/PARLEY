module Turn
  t : [0..2] init 0;

  // Movement phase
  [east] (t=0) -> (t'=1);
  [west] (t=0) -> (t'=1);
  [north] (t=0) -> (t'=1);
  [south] (t=0) -> (t'=1);

  // Update / skip phase
  [update_gps] (t=1) -> (t'=2);
  [skip_update] (t=1) -> (t'=0);

  // FSC phase after update_<svc>
  [UA_STEP_gps] (t=2) -> (t'=0);
endmodule
