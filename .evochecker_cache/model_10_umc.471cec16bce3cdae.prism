    (e_gps/4.0): (xhat'=8) & (yhat'=9) & (step_gps'=1) + 
    (e_gps/4.0): (xhat'=6) & (yhat'=9) & (step_gps'=1);
  [update_gps] due_gps & (x=8) & (y=0) -> 
